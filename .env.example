# 이 파일을 .env로 복사하고 각자 자기 API 키를 넣으세요.
# .env는 Git에 올라가지 않습니다. 관리자 화면 조회·수정에는 AI 키가 필요하지 않습니다.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 기존 Claude 실행을 쓸 때만 AI_PROVIDER=claude로 바꾸세요.
CLAUDE_MODEL=claude-sonnet-5-5

# 응답 대기 상한(초). 역할별 한도보다 짧게 줄이는 용도이며 전체 실행 시간은 아닙니다.
# 코스 60초, 총괄 10초, 수요 요약·검증·수집 30초. 실제 .env를 덮어쓰지 마세요.
AI_TIMEOUT_SECONDS=120

# 비밀키가 아닌 데이터 연결 설정. 필요할 때 다른 CSV 폴더·파일로 교체합니다.
HARUHARU_DATA_DIR=research/data
HARUHARU_PLACES_FILE=장소운영정보_중구동구_데모코스_2026.csv
HARUHARU_TRAVEL_FILE=이동시간_중구동구_데모코스_2026.csv
